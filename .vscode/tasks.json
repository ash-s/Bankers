{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: run (Spring Boot :8082)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/backend/run-backend.ps1"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "spring-boot",
        "pattern": [{ "regexp": "^(.*)$", "message": 1 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(Building prakash-bankers|Starting PrakashBankersApplication).*",
          "endsPattern": ".*Started PrakashBankersApplication.*"
        }
      },
      "presentation": {
        "group": "prakash-bankers",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Frontend: run (Vite :8081)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/frontend/run-frontend.ps1"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": [{ "regexp": "^(.*)$", "message": 1 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(VITE|vite).*",
          "endsPattern": ".*Local:.*"
        }
      },
      "presentation": {
        "group": "prakash-bankers",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Start App (backend + frontend)",
      "dependsOn": ["Backend: run (Spring Boot :8082)", "Frontend: run (Vite :8081)"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Stop App (free ports 8081 + 8082)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Get-NetTCPConnection -LocalPort 8081,8082 -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { Stop-Process -Id $_ -Force }; Write-Host 'Ports 8081 and 8082 are now free.'"
      ],
      "problemMatcher": []
    }
  ]
}
